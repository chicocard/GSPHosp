/* ============================================================================
   GSPHosp — folha de estilo global (compacta)
   Aplicar uma vez, logo após criar o QApplication:
       app.setStyle("Fusion")
       app.setFont(QFont("Segoe UI", 10))
       app.setStyleSheet(Path(...)/"theme.qss").read_text(encoding="utf-8"))
   Regra: NENHUM widget define tamanho de fonte ou altura fixa por conta própria.
   Tudo que é tamanho vem daqui.
   ========================================================================== */

* {
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 10pt;
}

QWidget {
    background: #f7f9f9;
    color: #16211f;
    selection-background-color: #0f766e;
    selection-color: #ffffff;
}

QMainWindow, QDialog { background: #f7f9f9; }

/* ---- texto ---------------------------------------------------------------- */
QLabel { background: transparent; padding: 0; }
QLabel[titulo="true"]  { font-size: 14pt; font-weight: 600; }
QLabel[subtitulo="true"] { font-size: 11pt; font-weight: 600; color: #16211f; }
QLabel[nota="true"]    { font-size: 9pt; color: #5b6b68; }

/* ---- botões --------------------------------------------------------------- */
QPushButton {
    background: #ffffff;
    border: 1px solid #c9d3d1;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 20px;
    max-height: 30px;
}
QPushButton:hover   { background: #eef3f2; border-color: #a9b8b5; }
QPushButton:pressed { background: #dfe7e5; }
QPushButton:disabled { color: #9aa7a4; background: #f0f3f2; border-color: #dfe5e4; }
QPushButton[primario="true"] {
    background: #0f766e; color: #ffffff; border-color: #0f766e; font-weight: 600;
}
QPushButton[primario="true"]:hover { background: #0d6760; }
QToolButton { border: 1px solid transparent; border-radius: 4px; padding: 3px; }
QToolButton:hover { background: #eef3f2; border-color: #c9d3d1; }

/* ---- campos --------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #c9d3d1;
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 20px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit { max-height: 28px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0f766e;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #ffffff; border: 1px solid #c9d3d1; selection-background-color: #d9f0ed; selection-color: #16211f;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; }
QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 15px; height: 15px; }

/* ---- agrupamentos --------------------------------------------------------- */
QGroupBox {
    border: 1px solid #d5dedc;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px 8px 6px 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #16211f;
}
QFrame[cartao="true"] {
    background: #ffffff;
    border: 1px solid #d5dedc;
    border-radius: 6px;
}

/* ---- abas ----------------------------------------------------------------- */
QTabWidget::pane { border: 1px solid #d5dedc; border-radius: 4px; top: -1px; background: #ffffff; }
QTabBar::tab {
    background: #eef3f2; border: 1px solid #d5dedc; border-bottom: none;
    padding: 5px 12px; margin-right: 2px; border-top-left-radius: 4px; border-top-right-radius: 4px;
}
QTabBar::tab:selected { background: #ffffff; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #e4ebe9; }

/* ---- tabelas -------------------------------------------------------------- */
QTableView, QTreeView, QListView {
    background: #ffffff;
    alternate-background-color: #f3f6f5;
    border: 1px solid #d5dedc;
    gridline-color: #e6ecea;
    selection-background-color: #d9f0ed;
    selection-color: #16211f;
    outline: none;
}
QTableView::item, QTreeView::item { padding: 2px 6px; }
QHeaderView::section {
    background: #eef3f2;
    color: #5b6b68;
    border: none;
    border-right: 1px solid #d5dedc;
    border-bottom: 1px solid #d5dedc;
    padding: 4px 6px;
    font-size: 9pt;
    font-weight: 600;
}
QTableCornerButton::section { background: #eef3f2; border: none; }

/* ---- barras de rolagem ---------------------------------------------------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #c3cfcc; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #a9b8b5; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #c3cfcc; border-radius: 5px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- divisores, progresso, dicas ----------------------------------------- */
QSplitter::handle { background: #d5dedc; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
QProgressBar { border: 1px solid #c9d3d1; border-radius: 4px; background: #ffffff; text-align: center; max-height: 16px; }
QProgressBar::chunk { background: #0f766e; border-radius: 3px; }
QToolTip { background: #16211f; color: #ffffff; border: none; padding: 4px 6px; font-size: 9pt; }
QStatusBar { font-size: 9pt; color: #5b6b68; }
QMenu { background: #ffffff; border: 1px solid #c9d3d1; padding: 4px; }
QMenu::item { padding: 4px 18px; border-radius: 3px; }
QMenu::item:selected { background: #d9f0ed; }

/* ---- navegação lateral (se existir) --------------------------------------- */
QListWidget[navegacao="true"] { background: #eef3f2; border: none; border-right: 1px solid #d5dedc; }
QListWidget[navegacao="true"]::item { padding: 6px 10px; }
QListWidget[navegacao="true"]::item:selected { background: #d9f0ed; color: #0f766e; font-weight: 600; border-radius: 4px; }
